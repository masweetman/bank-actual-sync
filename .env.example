# ─── Encryption key (required) ───────────────────────────────────────────────
# 64-character hex string used to encrypt sensitive settings in the database.
# IMPORTANT: keep this secret. If not set, the server auto-generates one and
# writes it here on first start.
ENCRYPTION_KEY=<auto-generated on first start>

# ─── Plaid credentials (required) ────────────────────────────────────────────
# Create an account at https://dashboard.plaid.com/ to get these.
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=production

# PLAID_ENV controls which Plaid environment is used:
#   production  — live bank data (default)
#   sandbox     — fake test data from Plaid's sandbox
# PLAID_ENV=production

# ─── Optional port override ───────────────────────────────────────────────────
# BACKEND_PORT=3001

# ─── All other settings are configured through the Settings UI in the app. ───
# Actual Budget connection (server URL, password, budget ID),
# admin password, and 2FA secret are all stored encrypted in the SQLite DB.
# You do NOT need to set those credentials here.
